{
  "realm": "ticketing",
  "enabled": true,
  "displayName": "EventFlow Ticketing",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "roles": {
    "realm": [
      { "name": "event-admin", "description": "Create and manage events" },
      { "name": "ticket-buyer", "description": "Purchase tickets" },
      { "name": "report-reader", "description": "View sales reports" }
    ]
  },
  "clientScopes": [
    {
      "name": "ticketing-api-audience",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" },
      "protocolMappers": [
        {
          "name": "ticketing-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "ticketing-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "ticketing-api",
      "name": "Ticketing APIs",
      "enabled": true,
      "bearerOnly": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "ticketing-web",
      "name": "Ticketing React UI",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [ "http://localhost:3000/*" ],
      "webOrigins": [ "http://localhost:3000" ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*"
      },
      "protocolMappers": [
        {
          "name": "ticketing realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "ticketing username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ],
      "defaultClientScopes": [ "profile", "email", "roles", "ticketing-api-audience" ]
    },
    {
      "clientId": "ticketing-cli",
      "name": "Local API demonstration client",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "ticketing realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "ticketing username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ],
      "defaultClientScopes": [ "profile", "email", "roles", "ticketing-api-audience" ]
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "email": "admin@example.local",
      "firstName": "Event",
      "lastName": "Administrator",
      "credentials": [ { "type": "password", "value": "Demo123!", "temporary": false } ],
      "realmRoles": [ "event-admin", "ticket-buyer", "report-reader" ]
    },
    {
      "username": "buyer",
      "enabled": true,
      "emailVerified": true,
      "email": "buyer@example.local",
      "firstName": "Ticket",
      "lastName": "Buyer",
      "credentials": [ { "type": "password", "value": "Demo123!", "temporary": false } ],
      "realmRoles": [ "ticket-buyer" ]
    },
    {
      "username": "analyst",
      "enabled": true,
      "emailVerified": true,
      "email": "analyst@example.local",
      "firstName": "Sales",
      "lastName": "Analyst",
      "credentials": [ { "type": "password", "value": "Demo123!", "temporary": false } ],
      "realmRoles": [ "report-reader" ]
    }
  ]
}
